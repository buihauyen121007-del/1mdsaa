{
  "version": 2,
  "public": true,
  "buildCommand": "node scripts/build-static.js",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "config/**,data/**,outputs/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
